<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyecto_tfg.HelloController">
    <children>
        <VBox spacing="10" alignment="CENTER" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">
            <Label text="Formulario de registro"/>
            <TextField promptText="Usuario"/>
            <PasswordField promptText="Contraseña"/>
            <Button fx:id="btnConfirmar" text="Confirmar"/>
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#onClose"/>
        </VBox>
    </children>
</AnchorPane>