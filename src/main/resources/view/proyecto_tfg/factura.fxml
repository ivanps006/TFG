<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.proyecto_tfg.controller.Controller"
            prefHeight="600.0" prefWidth="1000.0">

    <VBox spacing="20"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <!-- TÍTULO -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets left="20" top="10"/>
            </padding>
            <Label text="🧾 Gestión de Facturas"/>
        </HBox>

        <!-- BUSCADOR Y FILTROS -->
        <VBox spacing="10">
            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <!-- Primera fila: Búsqueda por texto -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tfBuscarFactura"
                           promptText="🔍 Buscar por DNI o ID..."
                           prefWidth="350"/>
                <!-- Botones de filtrado -->
                <Button text="Filtrar" onAction="#filtrarFacturasPorClienteYBicicleta"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+ Nueva Factura" onAction="#abrirAnadirFactura"/>
                <Button text="Exportar" onAction="#exportarFacturaPDF"/>
            </HBox>

            <!-- Segunda fila: Filtro por fecha -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Filtrar por fecha:" style="-fx-font-weight: bold;"/>

                <DatePicker fx:id="dpFechaFacturaFiltro"
                            prefWidth="150"/>

                <Button text="Filtrar fecha" onAction="#filtrarFacturasPorFecha"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

        </VBox>

        <!-- TABLA -->
        <TableView fx:id="tablaFacturas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdFactura"
                             text="ID"
                             prefWidth="80"/>

                <TableColumn fx:id="colFechaFactura"
                             text="Fecha"
                             prefWidth="120"/>

                <TableColumn fx:id="colClienteFactura"
                             text="Cliente (DNI)"
                             prefWidth="150"/>

                <TableColumn fx:id="colBiciFactura"
                             text="Bicicleta (Ref)"
                             prefWidth="150"/>

                <TableColumn fx:id="colTotalFactura"
                             text="Total (€)"
                             prefWidth="120"/>
            </columns>

            <placeholder>
                <Label text="No hay facturas registradas."/>
            </placeholder>
        </TableView>

        <!-- FOOTER -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <Insets left="20" right="20" bottom="15"/>
            </padding>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🗑 Eliminar" onAction="#abrirEliminarFactura"/>
            <Button text="← Volver" onAction="#volverPaginaPrincipal"/>
        </HBox>

    </VBox>
</AnchorPane>
