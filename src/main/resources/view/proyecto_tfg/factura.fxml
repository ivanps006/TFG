<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.proyecto_tfg.controller.Controller"
            prefWidth="1100"
            prefHeight="680"
            styleClass="root"
            stylesheets="@../css/stylePrincipalPage.css">

    <center>

        <VBox spacing="20" styleClass="content">

            <padding>
                <Insets top="22" right="26" bottom="22" left="26"/>
            </padding>

            <!-- CABECERA -->
            <HBox spacing="10" alignment="CENTER_LEFT">

                <Label text="🧾 Historial de facturas"
                       styleClass="section-title"/>

                <Label text="(registro completo)"
                       styleClass="subtitle-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+ Nueva factura"
                        styleClass="btn-primary"/>
            </HBox>

            <!-- TARJETA TABLA -->
            <VBox spacing="14"
                  styleClass="table-card"
                  VBox.vgrow="ALWAYS">

                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <!-- BARRA DE HERRAMIENTAS -->
                <HBox spacing="12" alignment="CENTER_LEFT">

                    <TextField fx:id="tfBuscarFactura"
                               promptText="Buscar por DNI, referencia o ID..."
                               prefWidth="300"
                               styleClass="search-bar"/>

                    <ComboBox fx:id="cbFiltroFactura"
                              promptText="Filtrar por..."
                              prefWidth="150"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Exportar"
                            styleClass="btn-secondary"/>

                    <Button text="Actualizar"
                            fx:id="btnActualizarFactura"
                            styleClass="btn-success"/>

                </HBox>

                <!-- TABLA -->
                <TableView fx:id="tablaFacturas"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colIdFactura"
                                     text="ID"
                                     maxWidth="80"/>

                        <TableColumn fx:id="colFechaFactura"
                                     text="Fecha"/>

                        <TableColumn fx:id="colClienteFactura"
                                     text="Cliente (DNI)"/>

                        <TableColumn fx:id="colBiciFactura"
                                     text="Bicicleta (Ref)"/>

                        <TableColumn fx:id="colTotalFactura"
                                     text="Total (€)"/>

                    </columns>

                    <placeholder>
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="No hay facturas registradas"/>
                            <Label text="Las facturas aparecerán aquí cuando se creen"
                                   styleClass="subtitle-label"/>
                        </VBox>
                    </placeholder>

                </TableView>

                <!-- ACCIONES -->
                <HBox alignment="CENTER_RIGHT" spacing="10">

                    <Button fx:id="btnEliminarFactura"
                            text="Eliminar factura"
                            styleClass="btn-danger"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>