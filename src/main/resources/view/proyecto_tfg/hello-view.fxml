<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.proyecto_tfg.controller.Controller"
           stylesheets="@../css/styleLoginPage.css"
           styleClass="login-root">

    <VBox alignment="CENTER"
          spacing="18"
          maxWidth="360"
          styleClass="login-card">

        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <!-- Logo / Nombre -->
        <Label text="Bienvenido a BMS"
               styleClass="login-logo"/>

        <Label text="Acceso mecánicos"
               styleClass="login-title"/>

        <!-- Usuario -->
        <VBox spacing="5">
            <Label text="Usuario"/>
            <TextField fx:id="txtUsuario"
                       promptText="Introduce tu usuario"/>
        </VBox>

        <!-- Contraseña -->
        <VBox spacing="5">
            <Label text="Contraseña"/>
            <PasswordField fx:id="txtContrasenia"
                           promptText="Introduce tu contraseña"/>
        </VBox>

        <!-- Error -->
        <Label fx:id="ErrorLogin"
               styleClass="login-error"
               wrapText="true"/>

        <!-- Botón login -->
        <Button text="Entrar al taller"
                fx:id="btnIniciarSesion"
                onAction="#validarCredenciales"
                maxWidth="Infinity"
                defaultButton="true"
                styleClass="btn-primary"/>

        <!-- Registro -->
        <HBox alignment="CENTER" spacing="6">
            <Label text="¿Nuevo mecánico?" styleClass="login-hint"/>
            <Button text="Crear cuenta"
                    fx:id="btnRegistrarse"
                    onAction="#onRegisterButtonClick"
                    styleClass="btn-link"/>
        </HBox>

    </VBox>

</StackPane>