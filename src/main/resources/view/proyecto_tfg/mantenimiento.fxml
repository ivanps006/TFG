<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyecto_tfg.controller.Controller"
            prefHeight="600.0" prefWidth="1000.0">

    <VBox spacing="20" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding><Insets left="20" top="10"/></padding>
            <Label text="🔧 Gestión de Mantenimiento"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets left="20" right="20"/></padding>
            <TextField fx:id="tfBuscarMantenimiento"
                       promptText="🔍 Buscar por ID mecánico, bicicleta, fecha..."
                       prefWidth="350"/>
            <Button text="Buscar" />
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nuevo Mantenimiento" />
            <Button text="✏️ Editar" />
            <Button text="🗑 Eliminar" />
        </HBox>

        <TableView fx:id="tablaMantenimientos" VBox.vgrow="ALWAYS">
            <padding><Insets left="20" right="20"/></padding>
            <columns>
                <TableColumn fx:id="colIdMantenimiento" text="ID"              prefWidth="60"/>
                <TableColumn fx:id="colIdMecanico"      text="ID Mecánico"    prefWidth="110"/>
                <TableColumn fx:id="colIdBicicleta"     text="ID Bicicleta"   prefWidth="110"/>
                <TableColumn fx:id="colFecha"           text="Fecha"          prefWidth="100"/>
                <TableColumn fx:id="colHoras"           text="Horas Trab."    prefWidth="90"/>
                <TableColumn fx:id="colObservaciones"   text="Observaciones"  prefWidth="300"/>
            </columns>
            <placeholder>
                <Label text="No hay registros de mantenimiento."/>
            </placeholder>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets left="20" right="20" bottom="15"/></padding>
            <Label fx:id="lblTotalMantenimientos" text="Total: 0 registros"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver" onAction="#volverPaginaPrincipal"/>
        </HBox>

    </VBox>
</AnchorPane>
