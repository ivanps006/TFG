<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyecto_tfg.controller.Controller"
            prefHeight="720.0" prefWidth="1050.0">

    <VBox spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

        <!-- CABECERA -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="4">
                <Label text="➕ Añadir pieza" styleClass="hero-title"/>
                <Label text="Crea una nueva pieza para el inventario" styleClass="hero-small"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <Separator/>

        <!-- CARD FORM -->
        <VBox spacing="16" styleClass="table-card">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

            <GridPane hgap="14" vgap="12">
                <columnConstraints>
                    <ColumnConstraints prefWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints prefWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Modelo -->
                <Label text="Modelo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPiezaModelo" promptText="Ej: XTR M9100"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Marca -->
                <Label text="Marca:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="tfPiezaMarca" promptText="Ej: Shimano"
                           GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <!-- Tipo -->
                <Label text="Tipo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPiezaTipo" promptText="Ej: Frenos / Cadena / Cubierta..."
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Stock -->
                <Label text="Stock:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Spinner fx:id="spPiezaStock" editable="true"
                         GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <!-- Precio -->
                <Label text="Precio (€):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPiezaPrecio" promptText="Ej: 19.99"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text=" " GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            </GridPane>

            <Separator/>

            <!-- ACCIONES -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancelar" styleClass="btn-secondary"
                        onAction="#volverPaginaPrincipal"/>
                <Button text="Guardar pieza" styleClass="btn-primary"
                        onAction="#guardarPieza"/>
            </HBox>
        </VBox>

    </VBox>
</AnchorPane>
