<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyecto_tfg.controller.MostrarInfoBiciController"
            prefWidth="1000" prefHeight="600"
            stylesheets="@../css/stylePrincipalPage.css">

    <!-- HEADER -->
    <top>
        <VBox spacing="15" styleClass="card-header">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <!-- TITULO -->
            <Label fx:id="lblTitulo"
                   text="🚲 Información de Bicicleta"
                   styleClass="title-big"/>

            <!-- DATOS PRINCIPALES -->
            <HBox spacing="40">

                <VBox styleClass="info-block">
                    <Label text="Referencia" styleClass="info-label"/>
                    <Label fx:id="lblInfoRef" text="—" styleClass="info-value"/>
                </VBox>

                <VBox styleClass="info-block">
                    <Label text="Marca / Modelo" styleClass="info-label"/>
                    <Label fx:id="lblNombreBici" text="—" styleClass="info-value"/>
                </VBox>

                <VBox styleClass="info-block">
                    <Label text="Estado" styleClass="info-label"/>
                    <Label fx:id="lblInfoEstado" text="—" styleClass="status-badge"/>
                </VBox>

                <VBox styleClass="info-block">
                    <Label text="Cliente (DNI)" styleClass="info-label"/>
                    <Label fx:id="lblInfoCliente" text="—" styleClass="info-value"/>
                </VBox>

            </HBox>

            <!-- DATOS TECNICOS -->
            <HBox spacing="30">

                <VBox styleClass="tech-block">
                    <Label text="Frenos" styleClass="info-label"/>
                    <Label fx:id="lblInfoFrenos" text="—" styleClass="info-value"/>
                </VBox>

                <VBox styleClass="tech-block">
                    <Label text="Transmisión" styleClass="info-label"/>
                    <Label fx:id="lblInfoTransmision" text="—" styleClass="info-value"/>
                </VBox>

                <VBox styleClass="tech-block">
                    <Label text="Suspensión Del." styleClass="info-label"/>
                    <Label fx:id="lblInfoSuspDel" text="—" styleClass="info-value"/>
                </VBox>

                <VBox styleClass="tech-block">
                    <Label text="Suspensión Tras." styleClass="info-label"/>
                    <Label fx:id="lblInfoSuspTras" text="—" styleClass="info-value"/>
                </VBox>

                <VBox styleClass="tech-block">
                    <Label text="Ruedas" styleClass="info-label"/>
                    <Label fx:id="lblInfoRuedas" text="—" styleClass="info-value"/>
                </VBox>

            </HBox>

        </VBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="15" styleClass="content">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="📋 Historial de mantenimientos"
                   styleClass="section-title"/>

            <!-- TABLA -->
            <VBox styleClass="table-card" VBox.vgrow="ALWAYS">

                <TableView fx:id="tablaMantenimientosBici"
                           VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn fx:id="colIdMtto" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colMecanicoMtto" text="Mecánico" prefWidth="140"/>
                        <TableColumn fx:id="colFechaMtto" text="Fecha" prefWidth="120"/>
                        <TableColumn fx:id="colHorasMtto" text="Horas" prefWidth="90"/>
                        <TableColumn fx:id="colObsMtto" text="Observaciones" prefWidth="450"/>
                    </columns>

                    <placeholder>
                        <Label text="No hay mantenimientos registrados"/>
                    </placeholder>

                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10"/>
                    </padding>

                    <Label fx:id="lblTotalMtto"
                           text="Total: 0 mantenimientos"
                           styleClass="subtitle-label"/>
                </HBox>

            </VBox>

        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="footer">

            <padding>
                <Insets top="10" right="25" bottom="20" left="25"/>
            </padding>

            <Button text="← Volver"
                    onAction="#volver"
                    styleClass="btn-secondary"/>

        </HBox>
    </bottom>

</BorderPane>