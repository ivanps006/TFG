<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyecto_tfg.controller.Controller"
            prefHeight="720.0" prefWidth="1050.0">

    <VBox spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

        <!-- CABECERA -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="4">
                <Label text="✏ Editar pieza" styleClass="hero-title"/>
                <Label text="Edita una pieza del inventario" styleClass="hero-small"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="↩ Volver" styleClass="btn-secondary"
                    onAction="#volverPaginaPrincipal"/>
        </HBox>

        <Separator/>

        <!-- CARD FORM -->
        <VBox spacing="16" styleClass="table-card">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

            <!-- ID solo lectura -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="ID:"/>
                <Label fx:id="lblPiezaId" text="—" styleClass="stat-title"/>
            </HBox>

            <GridPane hgap="14" vgap="12">
                <columnConstraints>
                    <ColumnConstraints prefWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints prefWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Modelo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPiezaModelo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Marca:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="tfPiezaMarca" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Tipo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPiezaTipo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Stock:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Spinner fx:id="spPiezaStock" editable="true"
                         GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Precio (€):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPiezaPrecio" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <Separator/>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancelar" styleClass="btn-secondary"
                        onAction="#volverPaginaPrincipal"/>
                <Button text="Guardar cambios" styleClass="btn-primary"
                        onAction="#guardarCambiosPieza"/>
            </HBox>
        </VBox>

    </VBox>
</AnchorPane>
