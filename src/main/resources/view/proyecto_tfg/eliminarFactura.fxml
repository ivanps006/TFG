<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyecto_tfg.controller.Controller"
            prefWidth="700"
            prefHeight="500"
            stylesheets="@../css/stylePrincipalPage.css">

    <!-- ===== CABECERA ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header">
            <Label text="🗑  Eliminar Factura" styleClass="title"/>
        </HBox>
    </top>

    <!-- ===== CONTENIDO ===== -->
    <center>
        <VBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" right="40" bottom="10" left="40"/>
            </padding>

            <!-- Datos de la factura -->
            <VBox spacing="6">
                <Label text="Datos de la factura" styleClass="subtitle"/>

                <!-- Fila 1: ID y Fecha -->
                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="ID Factura" styleClass="hint"/>
                        <Label fx:id="lblIdFacturaEliminar" text="—"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Fecha" styleClass="hint"/>
                        <Label fx:id="lblFechaFacturaEliminar" text="—"/>
                    </VBox>
                </HBox>

                <!-- Fila 2: Cliente y Bicicleta -->
                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Cliente (DNI)" styleClass="hint"/>
                        <Label fx:id="lblClienteFacturaEliminar" text="—"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Bicicleta (Ref)" styleClass="hint"/>
                        <Label fx:id="lblBicicletaFacturaEliminar" text="—"/>
                    </VBox>
                </HBox>

                <!-- Fila 3: Total -->
                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Total (€)" styleClass="hint"/>
                        <Label fx:id="lblTotalFacturaEliminar" text="—"/>
                    </VBox>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Mensaje de advertencia -->
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-background-color: rgba(220,38,38,0.08);
                         -fx-border-color: rgba(220,38,38,0.35);
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-padding: 10 14 10 14;">
                <Label text="⚠" style="-fx-font-size: 18px; -fx-text-fill: #dc2626;"/>
                <Label text="Esta acción es irreversible. La factura será eliminada permanentemente."
                       style="-fx-text-fill: #dc2626; -fx-font-size: 12.5px; -fx-font-weight: 700;
                              -fx-wrap-text: true;"
                       wrapText="true"/>
            </HBox>

        </VBox>
    </center>

    <!-- ===== BOTONES ===== -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="15" right="40" bottom="20" left="40"/>
            </padding>

            <Button text="← Cancelar"
                    fx:id="btnCancelar"
                    styleClass="btn-secondary"
                    onAction="#volverPaginaPrincipal"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🗑  Eliminar Factura"
                    fx:id="btnEliminar"
                    onAction="#eliminarFacturaConfirmada"/>
        </HBox>
    </bottom>

</BorderPane>
