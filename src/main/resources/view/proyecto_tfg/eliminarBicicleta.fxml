<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyecto_tfg.controller.Controller"
            prefWidth="600"
            prefHeight="520"
            stylesheets="@../css/stylePrincipalPage.css">

    <!-- ===== CABECERA ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header">
            <Label text="🗑  Eliminar Bicicleta" styleClass="title"/>
        </HBox>
    </top>

    <!-- ===== CONTENIDO ===== -->
    <center>
        <VBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" right="40" bottom="10" left="40"/>
            </padding>

            <!-- Datos de la bicicleta encontrada -->
            <VBox spacing="6">
                <Label text="Datos de la bicicleta" styleClass="subtitle"/>

                <!-- Fila 1: Referencia y Estado -->
                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Referencia" styleClass="hint"/>
                        <Label fx:id="lblRefBici" text="—"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Estado" styleClass="hint"/>
                        <Label fx:id="lblEstadoBici" text="—"/>
                    </VBox>
                </HBox>

                <!-- Fila 2: Marca y Modelo -->
                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Marca" styleClass="hint"/>
                        <Label fx:id="lblMarcaBici" text="—"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Modelo" styleClass="hint"/>
                        <Label fx:id="lblModeloBici" text="—"/>
                    </VBox>
                </HBox>

                <!-- Fila 3: Frenos y Transmisión -->
                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Frenos" styleClass="hint"/>
                        <Label fx:id="lblFrenosBici" text="—"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Transmisión" styleClass="hint"/>
                        <Label fx:id="lblTransmisionBici" text="—"/>
                    </VBox>
                </HBox>

                <!-- Fila 4: Suspensiones -->
                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Suspensión Delantera" styleClass="hint"/>
                        <Label fx:id="lblSuspDelBici" text="—"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Suspensión Trasera" styleClass="hint"/>
                        <Label fx:id="lblSuspTrasBici" text="—"/>
                    </VBox>
                </HBox>

                <!-- Fila 5: Ruedas y Cliente -->
                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Ruedas" styleClass="hint"/>
                        <Label fx:id="lblRuedasBici" text="—"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Cliente (DNI)" styleClass="hint"/>
                        <Label fx:id="lblClienteBici" text="—"/>
                    </VBox>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Mensaje de advertencia -->
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-background-color: rgba(220,38,38,0.08);
                         -fx-border-color: rgba(220,38,38,0.35);
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-padding: 10 14 10 14;">
                <Label text="⚠" style="-fx-font-size: 18px; -fx-text-fill: #dc2626;"/>
                <Label text="Esta acción es irreversible. La bicicleta será eliminada permanentemente."
                       style="-fx-text-fill: #dc2626; -fx-font-size: 12.5px; -fx-font-weight: 700;
                              -fx-wrap-text: true;"
                       wrapText="true"/>
            </HBox>

        </VBox>
    </center>

    <!-- ===== BOTONES ===== -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="15" right="40" bottom="20" left="40"/>
            </padding>

            <Button text="← Cancelar"
                    fx:id="btnCancelar"
                    styleClass="btn-secondary"
                    onAction="#volverPaginaPrincipal"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🗑  Eliminar Bicicleta"
                    fx:id="btnEliminar"
                    onAction="#eliminarBicicleta"
                    style="-fx-background-color: linear-gradient(to right, #dc2626, #ef4444);
                           -fx-text-fill: white;
                           -fx-font-weight: 800;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(220,38,38,0.35), 10, 0.2, 0, 3);"
            />
        </HBox>
    </bottom>

</BorderPane>
