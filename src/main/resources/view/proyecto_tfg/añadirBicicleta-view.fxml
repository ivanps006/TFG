<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyecto_tfg.controller.Controller"
            prefWidth="600"
            prefHeight="500"
            stylesheets="@../css/stylePrincipalPage.css">

    <!-- ===== CABECERA ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header">
            <Label text="➕ Añadir Bicicleta" styleClass="title"/>
        </HBox>
    </top>

    <!-- ===== CONTENIDO ===== -->
    <center>
        <VBox spacing="15" alignment="TOP_CENTER">
            <padding>
                <Insets top="25" right="40" bottom="25" left="40"/>
            </padding>

            <Label text="Datos de la bicicleta" styleClass="subtitle"/>

            <!-- Referencia -->
            <VBox spacing="5">
                <Label text="Referencia"/>
                <TextField fx:id="txtReferencia" promptText="Ej: BICI-001"/>
            </VBox>

            <!-- Marca y Modelo -->
            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Marca"/>
                    <TextField fx:id="txtMarca" promptText="Ej: Trek"/>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Modelo"/>
                    <TextField fx:id="txtModelo" promptText="Ej: X-Caliber 8"/>
                </VBox>
            </HBox>

            <!-- Cliente -->
            <VBox spacing="5">
                <Label text="Cliente"/>
                <TextField fx:id="txtCliente" promptText="Nombre del cliente"/>
            </VBox>

            <!-- Estado -->
            <VBox spacing="5">
                <Label text="Estado"/>
                <ComboBox fx:id="cmbEstado" promptText="Selecciona estado"/>
            </VBox>
        </VBox>
    </center>

    <!-- ===== BOTONES ===== -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>

            <Button text="Cancelar"
                    fx:id="btnCancelar"
                    styleClass="btn-secondary"/>

            <Button text="Guardar Bicicleta"
                    fx:id="btnGuardar"
                    styleClass="btn-primary"/>
        </HBox>
    </bottom>

</BorderPane>
